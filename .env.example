# Example environment for Challenge Captcha Bot
#
# Copy to `.env` and fill in what you need. Everything here is OPTIONAL:
# the bot runs fully local with no API keys and no cloud OCR.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real tokens.

# ---------------------------------------------------------------------------
# Lab server (only needed if you run `bot.cli serve`)
# ---------------------------------------------------------------------------
# HMAC secret for session tokens (human vs ai_agent).
# Leave unset and the server generates one at app/.session_secret (mode 0600).
# CAPTCHA_LAB_SECRET=

# Lab mode: true = challenges always pass the behavioural gate.
# false = production mode, the gate blocks.  (default: false)
# LAB_MODE=false

# Minimum behavioural score to accept a solve. (default: 0.50)
# HUMAN_SCORE_MIN=0.50

# ---------------------------------------------------------------------------
# Targets you are authorised to test
# ---------------------------------------------------------------------------
# Base URL of the target application.
# TARGET_BASE_URL=https://staging.example.tld

# Path that returns the challenge as JSON.
# TARGET_CHALLENGE_PATH=/api/captcha

# Path that accepts the answer.
# TARGET_SUBMIT_PATH=/api/verify

# Bearer token, if the challenge endpoint needs one.
# TARGET_TOKEN=

# CSS selectors for browser mode.
# TARGET_IMAGE_SELECTOR=#captcha-image
# TARGET_PIECE_SELECTOR=#captcha-piece
# TARGET_INPUT_SELECTOR=#captcha-input
# TARGET_SUBMIT_SELECTOR=#captcha-submit

# ---------------------------------------------------------------------------
# Behaviour engine
# ---------------------------------------------------------------------------
# Maximum angular deviation applied to the synthesised pointer trace,
# in degrees. Higher = rougher human motion. (default: 14)
# TRACE_ARC_DEGREES=14

# Random seed for the trace generator. Leave unset for non-deterministic
# traces (which is what you want against a real target).
# TRACE_SEED=
